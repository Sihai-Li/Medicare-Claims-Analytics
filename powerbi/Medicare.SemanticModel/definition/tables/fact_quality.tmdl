table fact_quality
	lineageTag: d88d6f97-17c1-4b96-af70-42c10aba3d0a

	column dataset
		dataType: string
		lineageTag: 8f485125-fada-4d45-8f3c-322400e97101
		summarizeBy: none
		sourceColumn: dataset

	column check_name
		dataType: string
		lineageTag: 750433e9-d597-48f1-9514-5c7e79cc6f0e
		summarizeBy: none
		sourceColumn: check_name

	column exception_count
		dataType: int64
		lineageTag: 8b32e008-91bc-4712-9960-7e5c602eff83
		summarizeBy: none
		sourceColumn: exception_count

	partition fact_quality = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_quality.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"dataset", type text}, {"check_name", type text}, {"exception_count", Int64.Type}}, "en-US")
				in
				    Typed

