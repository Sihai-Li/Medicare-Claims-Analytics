	partition dim_cohort = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_cohort.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"cohort_key", type text}, {"cohort_label", type text}, {"definition", type text}}, "en-US")
				in
				    Typed

