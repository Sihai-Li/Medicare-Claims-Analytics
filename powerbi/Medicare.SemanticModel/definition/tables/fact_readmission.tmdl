	partition fact_readmission = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_readmission.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"episode_key", type text}, {"beneficiary_id", type text}, {"service_year", Int64.Type}, {"cohort_key", type text}, {"age_band", type text}, {"admission_date", type text}, {"discharge_date", type text}, {"followup_end", type text}, {"next_admission", type text}, {"next_episode_key", type text}, {"days_to_next", Int64.Type}, {"claim_count", Int64.Type}, {"date_span_days", Int64.Type}, {"base_payment", type number}, {"eligibility_reason", type text}, {"eligible_index", Int64.Type}, {"readmitted_30d", Int64.Type}, {"multiple_claims_episode", Int64.Type}}, "en-US"),
				    AnalysisPeriod = Table.SelectRows(Typed, each [service_year] >= 2016 and [service_year] <= 2022)
				in
				    AnalysisPeriod

