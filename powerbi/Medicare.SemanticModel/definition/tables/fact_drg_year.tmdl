table fact_drg_year
	lineageTag: c6185da2-0b84-422b-a0ed-3e9de6c419e6

	column service_year
		dataType: int64
		lineageTag: 15574f8e-99a8-420a-af44-f6ce3e5af08b
		summarizeBy: none
		sourceColumn: service_year

	column drg_code
		dataType: string
		lineageTag: 79b9b39a-a17e-4d4e-9aa1-c8088b0826bd
		summarizeBy: none
		sourceColumn: drg_code

	column claim_count
		dataType: int64
		lineageTag: 9c770829-95b7-4bac-b52f-da8eafe094fc
		summarizeBy: none
		sourceColumn: claim_count

	column base_payment
		dataType: double
		lineageTag: b210ad98-4d82-4b9c-8065-608fa219bd8e
		summarizeBy: none
		sourceColumn: base_payment

	column charges
		dataType: double
		lineageTag: 943c2bd0-5876-41c8-8cd5-45246b8f34a3
		summarizeBy: none
		sourceColumn: charges

	column date_span_days
		dataType: int64
		lineageTag: f6954418-0b0d-497d-bec6-aa4375dd9336
		summarizeBy: none
		sourceColumn: date_span_days

	column claims_with_date_span
		dataType: int64
		lineageTag: 2f4178e3-7302-49a7-917b-7f14d147d351
		summarizeBy: none
		sourceColumn: claims_with_date_span

	partition fact_drg_year = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_drg_year.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"service_year", Int64.Type}, {"drg_code", type text}, {"claim_count", Int64.Type}, {"base_payment", type number}, {"charges", type number}, {"date_span_days", Int64.Type}, {"claims_with_date_span", Int64.Type}}, "en-US"),
				    AnalysisPeriod = Table.SelectRows(Typed, each [service_year] >= 2016 and [service_year] <= 2022)
				in
				    AnalysisPeriod

