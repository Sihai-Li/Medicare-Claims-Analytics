	partition fact_service_month = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_service_month.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"service_year", Int64.Type}, {"service_month", type text}, {"service_category", type text}, {"cohort_key", type text}, {"age_band", type text}, {"record_count", Int64.Type}, {"base_payment", type number}, {"total_medicare_payment", type number}, {"charges", type number}, {"records_with_charge", Int64.Type}, {"matched_payment", type number}, {"matched_charge", type number}, {"date_span_days", Int64.Type}, {"claims_with_date_span", Int64.Type}, {"covered_days", Int64.Type}, {"drug_total_cost", type number}}, "en-US"),
				    AnalysisPeriod = Table.SelectRows(Typed, each [service_year] >= 2016 and [service_year] <= 2022)
				in
				    AnalysisPeriod

