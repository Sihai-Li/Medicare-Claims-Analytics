	partition fact_patient_year = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_patient_year.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"beneficiary_year_key", type text}, {"beneficiary_id", type text}, {"service_year", Int64.Type}, {"cohort_key", type text}, {"age_band", type text}, {"sex_code", type text}, {"state_code", type text}, {"eligible_ffs_member_months", Int64.Type}, {"claim_count", Int64.Type}, {"base_payment", type number}, {"inpatient_claim_count", Int64.Type}, {"eligible_index_episodes", Int64.Type}, {"readmissions", Int64.Type}}, "en-US"),
				    AnalysisPeriod = Table.SelectRows(Typed, each [service_year] >= 2016 and [service_year] <= 2022)
				in
				    AnalysisPeriod

